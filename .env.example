# ─────────────────────────────────────────────────────────────────────────────
# War Machine — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Python scripts use SUPABASE_SERVICE_ROLE_KEY (bypasses RLS)
# Next.js app uses both public + service role
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key

# ── OpenRouter (tiered AI routing) ───────────────────────────────────────────
# Recruit/Lieutenant → mistral/mistral-7b-instruct:free (free)
# Admiral           → deepseek/deepseek-chat (paid, high quality)
OPENROUTER_API_KEY=sk-or-v1-...
# Optional: force a specific model for all ranks
# OPENROUTER_MODEL=mistral/mistral-7b-instruct:free

# ── Resend (email delivery) ──────────────────────────────────────────────────
# From: verified domain in Resend dashboard
RESEND_API_KEY=re_...
FROM_EMAIL=recon@yourdomain.com
FROM_NAME=Shadow Agency — Recon Division

# ── App URLs ─────────────────────────────────────────────────────────────────
# Used for CTA links in cold emails and click-tracker redirects
NEXT_PUBLIC_APP_URL=https://your-war-machine.vercel.app
APP_BASE_URL=https://your-war-machine.vercel.app
TRACK_BASE_URL=https://your-war-machine.vercel.app/api/track

# ── Scraper settings ─────────────────────────────────────────────────────────
MAX_LEADS_PER_RUN=50
HEADLESS=true
EMAIL_DELAY_SECONDS=2.5
SCRAPE_DELAY_SECONDS=1.5

# ── Send gate (outreach_policy.evaluate_send) ────────────────────────────────
# Every outbound email is checked against these. A missing value does not
# fall back to a permissive default — it refuses the send. See README.

# REQUIRED. Commercial email must identify the sender with a real physical
# address. Leave this blank and every send is refused with
# `no_postal_address`.
POSTAL_ADDRESS=Your Company Ltd, 1 Example Street, City, Postcode, Country

# REQUIRED. Base URL for the one-click opt-out. A per-recipient token is
# appended as ?token=<click_token>. Blank means every send is refused with
# `no_unsubscribe`.
UNSUBSCRIBE_BASE_URL=https://your-war-machine.vercel.app/api/unsubscribe

# Volume and pacing. The cap is what turns an accidental loop into a bad hour
# instead of a burned sending domain.
DAILY_SEND_CAP=40
DOMAIN_COOLDOWN_DAYS=180

# Business hours in UTC. Cold mail that lands at 03:00 reads as a bot.
SEND_WINDOW_START_HOUR=8
SEND_WINDOW_END_HOUR=18
SEND_WEEKENDS=false

# ── ForgeGuard ↔ Railway handshake ───────────────────────────────────────────
# Must byte-match forgeguard-ai Vercel INTERNAL_SCAN_TOKEN
INTERNAL_SCAN_TOKEN=your-shared-internal-scan-token
